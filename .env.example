# Google Maps API Key
# Get your API key from: https://developers.google.com/maps/documentation/javascript/get-api-key
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Database (for future backend integration)
# DATABASE_URL=postgresql://user:password@localhost:5432/openspoke

# JWT Secret (for authentication)
# JWT_SECRET=your_jwt_secret_here

# API URLs (for future backend)
# NEXT_PUBLIC_API_URL=http://localhost:3000/api
